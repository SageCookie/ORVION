# ORVION Environment Configuration
# NOTE: These defaults work for Docker Compose out-of-the-box.
# Copy this to .env if you want to customize values.

# Server Settings
PORT=8080

# Database Credentials (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=orvion_db
DB_USERNAME=orvion_user
DB_PASSWORD=orvion_secure_password_123

# JWT Configuration (CHANGE IN PRODUCTION!)
JWT_SECRET=404D635166546A576E5A7234753778214125442A472D4B6150645267556B5870
JWT_EXPIRATION_MS=86400000

# ML Service (optional - backend will start without it)
# ORVION_ML_BASE_URL=http://ml-service:8000

# File Storage Configuration
STORAGE_LOCATION=/app/uploads

# Frontend API URL (for local development outside Docker)
VITE_API_BASE_URL=http://localhost:8080/api/v1
