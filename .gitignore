# ==============================================================================
# ORVION: Root .gitignore
# ==============================================================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Environment and Secret files
.env
.env.local
.env.*.local
*.pem
*.key

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==============================================================================
# Backend (Java / Spring Boot / Maven)
# ==============================================================================
backend/target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Maven local repository / wrapper jar (optional)
!backend/.mvn/wrapper/maven-wrapper.jar
!backend/.mvn/wrapper/maven-wrapper.properties

# Virtual machine crash logs
hs_err_pid*
replay_pid*

# H2 database file storage
*.mv.db
*.trace.db

# ==============================================================================
# Frontend (Node.js / React / Vite)
# ==============================================================================
frontend/node_modules/
**/node_modules/
frontend/dist/
**/dist/
frontend/build/
**/build/
.vite/
*.local

# TypeScript build info
*.tsbuildinfo
.eslintcache

# ==============================================================================
# IDEs and Editors
# ==============================================================================
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# Temporary / Scratch directories
scratch/
tmp/
temp/
.github/modernize/
